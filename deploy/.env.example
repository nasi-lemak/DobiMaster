# Copy to deploy/.env (scripts/setup-server.sh does this and fills in the secrets for you).
# Never commit deploy/.env.

# --- Required ---------------------------------------------------------------
# Your domain, already pointing (DNS "A" record) at this server's IP. No https://, no slash.
DOMAIN=app.example.my
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.my
# Long random strings. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# --- Who can create a business account ----------------------------------------
# open   = any laundromat owner can sign up (DobiMaster as a service)
# first  = only the first account (a private server for one business)
# closed = nobody (accounts already exist)
SIGNUP_MODE=open

# --- Payments ------------------------------------------------------------------
# none = customers pay with coins as usual; pay-in-app hidden. Change only when a real gateway is connected.
PAYMENT_PROVIDER=none

# --- Owner emails (weekly summary, password reset) ---------------------------------
# Without SMTP_URL, emails are only written to the log — password reset won't reach anyone.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=DobiMaster <no-reply@app.example.my>

# --- WhatsApp alerts (Meta WhatsApp Cloud API) ---------------------------------------
# Without WHATSAPP_TOKEN the WhatsApp button is hidden; web push alerts still work.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_NUMBER=60123456789
# WHATSAPP_DIGEST_TEMPLATE=

# --- Web push (optional) -------------------------------------------------------
# Generated and stored in the database on first start if left empty. Set them only to move servers.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.my

# --- Backups -------------------------------------------------------------------
# Nightly database + photo backups land in deploy/backups (kept BACKUP_KEEP_DAYS days).
BACKUP_KEEP_DAYS=14
# Hour of day to run the nightly backup, in UTC (19 = 3 am in Malaysia).
BACKUP_HOUR=19

# --- Demo server only -------------------------------------------------------------
# SHOW_DEMO_LOGINS=true          # show demo accounts on the sign-in page (needs the demo seed)
# PAYMENT_PROVIDER=mock          # fake payment page: anyone can "pay" for free
# ALLOW_MOCK_PAYMENTS=true
