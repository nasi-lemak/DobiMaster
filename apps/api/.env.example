# Copy to .env for local development.
DATABASE_URL=postgres://dobi:dobi@localhost:5432/dobimaster
PUBLIC_URL=http://localhost:5173
PORT=3000
# Required in production (long random string):
# JWT_SECRET=
# Web push (optional: generated and stored in the DB on first boot if absent). `npx web-push generate-vapid-keys`
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
PAYMENT_PROVIDER=mock
START_CONFIRM_SEC=90

# Photos (reports, checklists). Local disk for a single-VPS deployment — include it in backups.
UPLOAD_DIR=./data/uploads

# WhatsApp Cloud API (Meta). Leave WHATSAPP_TOKEN empty to use the mock transport (dev), which
# enables POST /api/v1/dev/whatsapp/inbound to simulate a customer sending the link code.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=          # verifies X-Hub-Signature-256 on /api/v1/webhooks/whatsapp
# WHATSAPP_VERIFY_TOKEN=        # webhook verification handshake
WHATSAPP_NUMBER=60000000000     # business number customers message (digits only)
# WHATSAPP_DIGEST_TEMPLATE=     # approved template for the weekly owner digest outside the 24 h window

# Owner emails (weekly digest). Without SMTP_URL emails are logged instead of sent.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM=DobiMaster <no-reply@example.com>

# Who operates this server: shown in the privacy notice and terms (/privacy, /terms).
# LEGAL_OPERATOR_NAME=Your Company Sdn. Bhd.
# LEGAL_REGISTRATION_NO=202601234567 (1234567-X)
# LEGAL_ADDRESS=
# LEGAL_CONTACT_EMAIL=privacy@example.my
# LEGAL_DATA_LOCATION=Singapore
