# Copy to .env for local development.
DATABASE_URL=postgres://dobi:dobi@localhost:5432/dobimaster
PUBLIC_URL=http://localhost:5173
PORT=3000
# Required in production (long random string):
# JWT_SECRET=
# Web push (optional: generated and stored in the DB on first boot if absent). `npx web-push generate-vapid-keys`
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
PAYMENT_PROVIDER=mock
START_CONFIRM_SEC=90
